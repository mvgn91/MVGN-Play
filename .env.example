# Variables de entorno del sitio MVGN Play.
# Copia este archivo a `.env` (ignorado por git) solo si necesitas sobrescribir
# los valores por defecto.

# Dominio comercial. PENDIENTE_OPERADOR: mientras falte, el sitio compila con el
# TLD reservado `https://mvgnplay.example` y canonical, sitemap y Open Graph
# quedan en placeholder.
PUBLIC_SITE_URL=

# Número comercial de WhatsApp. Por defecto el sitio usa el número entregado por
# el operador (+52 1 33 2262 1939). Defínelo aquí solo para cambiarlo.
# Formato: solo dígitos, internacional (ej. 5213312345678).
PUBLIC_WHATSAPP_NUMBER=
