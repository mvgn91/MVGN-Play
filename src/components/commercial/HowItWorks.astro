---
const steps = [
  {
    number: '01',
    title: 'Elige tu modalidad',
    body: 'Con equipo incluido, con tu propia TV Box o añadiendo instalación presencial.',
  },
  {
    number: '02',
    title: 'Configuramos',
    body: 'Preparamos la interfaz, ajustamos las aplicaciones incluidas y probamos la entrega.',
  },
  {
    number: '03',
    title: 'Tienes soporte',
    body: 'Puedes solicitar asistencia durante 12 meses conforme al alcance contratado.',
  },
];
---

<section id="como-funciona" class="scroll-mt-24 border-t border-line/60">
  <div class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="max-w-2xl" data-reveal>
      <p class="label-tech">Cómo funciona</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Tres pasos, sin vueltas técnicas.</h2>
    </div>

    <ol class="mt-10 grid gap-4 md:grid-cols-3">
      {
        steps.map((step, index) => (
          <li
            class="relative rounded-panel border border-line bg-surface/50 p-6"
            data-reveal
            style={`--reveal-delay: ${index * 0.08}s`}
          >
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs text-cool">{step.number}</span>
              {index < steps.length - 1 && (
                <span aria-hidden="true" class="hidden text-ink-muted md:inline">
                  →
                </span>
              )}
            </div>
            <h3 class="mt-3 font-display text-xl font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm text-ink-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
