---
// Compatibilidad y condiciones (PRD §9.8) — rediseño: la sección pasa de una
// lista plana a dos caras de la misma decisión, lo que cubre el servicio y lo
// que depende de terceros. Todo el contenido sigue siendo el del PRD.
const cobertura = [
  'Soporte de 12 meses desde la activación registrada.',
  'Aplicaciones para películas, series y televisión, configuradas y probadas.',
  'Si una aplicación deja de servir, se instala una alternativa viable.',
  'Instalación presencial opcional, dentro de la zona de cobertura.',
];

const depende = [
  'El alcance y el contenido de las aplicaciones puede cambiar sin aviso.',
  'El funcionamiento de servicios externos no depende de MVGN Play.',
  'Los envíos fuera de la Zona Metropolitana de Guadalajara se cotizan aparte.',
  'Los requisitos técnicos se confirman sobre el modelo exacto al contratar.',
];
---

<section id="condiciones" class="scroll-mt-28 border-t border-line/60 backdrop-blur-xl">
  <div class="relative overflow-hidden">
    <div
      aria-hidden="true"
      class="glow-crimson pointer-events-none absolute inset-x-0 top-0 h-72 opacity-50 [mask-image:radial-gradient(50%_100%_at_50%_0%,black,transparent)]"
      data-parallax="0.16"
    >
    </div>

    <div class="relative mx-auto w-full max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="max-w-2xl" data-reveal>
        <p class="label-tech">Compatibilidad y condiciones</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Lo que cubre y lo que no depende de nosotros.</h2>
        <p class="mt-4 text-ink-muted">
          Preferimos decirlo antes de que lo preguntes: configuramos el equipo y damos soporte técnico; el contenido de
          las aplicaciones lo deciden sus proveedores.
        </p>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-12">
        <!-- Cubierto -->
        <article
          class="md:col-span-6 rounded-panel border border-crimson/45 bg-crimson/[0.05] p-6"
          data-reveal
          style="--reveal-delay: 0.05s"
        >
          <div class="flex items-center justify-between border-b border-crimson/30 pb-3">
            <p class="label-tech">Cubierto por el servicio</p>
            <span class="font-mono text-[0.625rem] text-crimson">{cobertura.length} puntos</span>
          </div>

          <ol class="mt-4 space-y-4">
            {
              cobertura.map((item, index) => (
                <li class="flex gap-4">
                  <span class="mt-0.5 font-mono text-[0.625rem] text-crimson">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="text-sm leading-relaxed text-ink">{item}</span>
                </li>
              ))
            }
          </ol>
        </article>

        <!-- Depende de terceros -->
        <article
          class="md:col-span-6 rounded-panel border border-line bg-surface/50 p-6"
          data-reveal
          style="--reveal-delay: 0.12s"
        >
          <div class="flex items-center justify-between border-b border-line pb-3">
            <p class="label-tech">Depende de terceros</p>
            <span class="font-mono text-[0.625rem] text-cool">{depende.length} puntos</span>
          </div>

          <ol class="mt-4 space-y-4">
            {
              depende.map((item, index) => (
                <li class="flex gap-4">
                  <span class="mt-0.5 font-mono text-[0.625rem] text-cool">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="text-sm leading-relaxed text-ink-muted">{item}</span>
                </li>
              ))
            }
          </ol>
        </article>

        <!-- Tarjeta de compatibilidad del dispositivo (ancho total) -->
        <article
          class="md:col-span-12 rounded-panel border border-line bg-surface/50 p-6 sm:p-8"
          data-reveal
          style="--reveal-delay: 0.25s"
        >
          <div class="flex items-center justify-between border-b border-line pb-3 mb-4">
            <p class="label-tech">Compatibilidad del dispositivo</p>
          </div>

          <p class="text-sm text-ink-muted mb-4 leading-relaxed">
            MVGN Play configura TV Box con aplicaciones para películas, series y
            televisión. La compatibilidad depende del sistema operativo y el
            fabricante del equipo.
          </p>

          <div class="grid gap-6 lg:grid-cols-3 mb-6">
            <div class="border border-line/50 bg-surface/30 p-5 rounded-none">
              <h4 class="text-ink font-display font-semibold mb-2">Android TV / Google TV</h4>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-none border border-crimson/30 bg-crimson/10 text-crimson text-[0.7rem] font-semibold uppercase tracking-wider mb-3 block">
                Compatible
              </span>
              <p class="text-sm text-ink-muted leading-relaxed">
                Algunas aplicaciones externas pueden tener restricciones del fabricante.
              </p>
            </div>
            <div class="border border-line/50 bg-surface/30 p-5 rounded-none">
              <h4 class="text-ink font-display font-semibold mb-2">Fire TV</h4>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-none border border-cool/30 bg-cool/10 text-cool text-[0.7rem] font-semibold uppercase tracking-wider mb-3 block">
                Parcial
              </span>
              <p class="text-sm text-ink-muted leading-relaxed">
                Personalización de inicio y aplicaciones externas limitadas.
              </p>
            </div>
            <div class="border border-line/50 bg-surface/30 p-5 rounded-none">
              <h4 class="text-ink font-display font-semibold mb-2">Otros sistemas</h4>
              <p class="text-sm text-ink-muted leading-relaxed mb-3">
                Tizen, webOS, VIDAA, Roku OS, tvOS
              </p>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-none border border-line/50 bg-surface text-ink-muted text-[0.7rem] font-semibold uppercase tracking-wider block">
                No compatible
              </span>
            </div>
          </div>

          <div class="pt-6 border-t border-line">
            <p class="label-tech text-[0.75rem] mb-3">Antes de contratar con equipo propio</p>
            <ul class="space-y-2 text-sm text-ink">
              <li class="flex items-start gap-2">
                <span class="mt-0.5 text-crimson font-bold">✓</span>
                <span>Confirmar el modelo exacto del dispositivo.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-0.5 text-crimson font-bold">✓</span>
                <span>Verificar sistema operativo y versión de firmware.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-0.5 text-crimson font-bold">✓</span>
                <span>Consultar restricciones del fabricante para aplicaciones externas.</span>
              </li>
            </ul>
          </div>

          <p class="mt-5 text-[0.75rem] text-ink-muted leading-relaxed">
            MVGN Play no garantiza que todos los dispositivos permitan instalar
            las mismas aplicaciones ni personalizar la interfaz de la misma
            manera.
          </p>
        </article>
      </div>

      <div
        class="mt-6 flex flex-col gap-3 rounded-panel border border-line/70 bg-surface/40 px-5 py-4 sm:flex-row sm:items-center sm:justify-between"
        data-reveal
        style="--reveal-delay: 0.18s"
      >
        <p class="text-sm text-ink-muted">
          El soporte es remoto por defecto. La vigencia es de 12 meses desde la activación registrada.
        </p>
        <div class="flex flex-wrap gap-4">
          <a class="text-sm text-cool underline-offset-4 hover:underline" href="/condiciones">
            Condiciones completas
          </a>
          <a class="text-sm text-cool underline-offset-4 hover:underline" href="/soporte">
            Alcance del soporte
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
