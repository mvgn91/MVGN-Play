---
// CTA final (PRD §9.10). Cierre sobrio: una sola acción principal.
import WhatsAppCta from '@/components/ui/WhatsAppCta.astro';
---

<section id="consulta" class="scroll-mt-24 border-t border-line/60">
  <div class="relative overflow-hidden">
    <div
      aria-hidden="true"
      class="glow-crimson pointer-events-none absolute inset-x-0 -bottom-40 h-96 opacity-60"
      data-parallax="0.18"
    ></div>

    <div class="relative mx-auto grid w-full max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div data-reveal>
        <p class="label-tech">Siguiente paso</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Empieza con una configuración hecha para ti.</h2>
        <p class="mt-4 max-w-xl text-ink-muted">
          Cuéntanos qué televisión o dispositivo tienes y te ayudamos a identificar la modalidad adecuada.
        </p>
        <div class="mt-7">
          <WhatsAppCta label="Consultar por WhatsApp" />
        </div>
      </div>

      <div aria-hidden="true" class="relative hidden lg:block">
        <div class="mx-auto w-full max-w-sm rounded-panel border border-line bg-surface/60 p-4">
          <div class="flex items-center justify-between border-b border-line pb-3">
            <span class="label-tech">Capa de contenido</span>
            <span class="font-mono text-[0.625rem] text-cool">lista</span>
          </div>
          <div class="mt-4 grid gap-2">
            {Array.from({ length: 4 }).map((_, index) => (
              <div class="flex items-center gap-3">
                <div
                  class:list={['h-1 rounded-none', index === 0 ? 'w-10 bg-crimson' : 'w-6 bg-line-strong']}
                />
                <div
                  class:list={[
                    'h-1 flex-1 rounded-none',
                    index === 0 ? 'bg-crimson/40' : 'bg-line',
                  ]}
                />
              </div>
            ))}
          </div>
          <div class="mt-4 flex items-center justify-between border-t border-line pt-3">
            <span class="font-mono text-[0.625rem] text-ink-muted">películas · series · tv</span>
            <span class="font-mono text-[0.625rem] text-ink-muted">12 m</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
