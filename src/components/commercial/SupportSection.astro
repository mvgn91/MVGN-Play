---
// Valor del soporte (PRD §9.7). La animación se limita a ilustrar el proceso:
// no promete que todo problema se resuelva.
import { SUPPORT_MONTHS } from '@/config/commerce';

const cycle = [
  { step: 'Detectar', body: 'Nos dices qué dejó de funcionar o qué cambió en tu equipo.' },
  { step: 'Diagnosticar', body: 'Revisamos configuración, red y comportamiento de las aplicaciones usadas.' },
  { step: 'Ajustar o sustituir', body: 'Corregimos la configuración o ponemos en su lugar una alternativa viable que cubra lo que dejó de funcionar.' },
  { step: 'Verificar', body: 'Queda constancia del cambio y de lo que quedó fuera de alcance.' },
];
---

<section id="soporte" class="scroll-mt-24 border-t border-line/60 backdrop-blur-xl">
  <div class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-start">
      <div>
        <p class="label-tech">Soporte técnico</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl" data-reveal>La tecnología cambia. El soporte continúa.</h2>
        <p class="mt-4 text-ink-muted">
          Lo que contratas es una capa de aplicaciones funcionando. Como las aplicaciones y los métodos de
          configuración cambian, el soporte cubre durante {SUPPORT_MONTHS} meses diagnosticar incidencias, ajustar
          configuraciones e instalar alternativas técnicamente viables cuando una deja de servir.
        </p>

        <div class="mt-6 inline-flex items-baseline gap-3 rounded-none border border-line px-5 py-3">
          <span class="font-display text-2xl font-semibold">{SUPPORT_MONTHS}</span>
          <span class="text-sm text-ink-muted">meses de soporte incluidos</span>
        </div>

        <p class="mt-6 text-sm text-ink-muted">
          El soporte es remoto por defecto. No incluye reparaciones físicas ni reemplazo de hardware, y no garantiza
          que el contenido de las aplicaciones incluidas permanezca disponible de forma indefinida.
        </p>
        <a class="mt-4 inline-flex text-sm text-cool underline-offset-4 hover:underline" href="/soporte">
          Ver alcance y condiciones del soporte
        </a>
      </div>

      <ol class="grid gap-3 sm:grid-cols-2" data-reveal style="--reveal-delay: 0.08s">
        {
          cycle.map((item, index) => (
            <li class="rounded-panel border border-line bg-surface/50 p-5">
              <span class="font-mono text-xs text-cool">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="mt-2 font-display text-lg font-semibold">{item.step}</h3>
              <p class="mt-1 text-sm text-ink-muted">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
