---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteNav from '@/layouts/SiteNav.astro';
import SiteFooter from '@/layouts/SiteFooter.astro';
import { SITE } from '@/config/site';
---

<BaseLayout
  title={`Página no encontrada — ${SITE.name}`}
  description="La página que buscas no existe o cambió de ubicación."
>
  <SiteNav />

  <main id="contenido" class="relative flex min-h-[70vh] items-center pt-24">
    <div aria-hidden="true" class="glow-crimson pointer-events-none absolute inset-x-0 -top-24 h-80 opacity-60"></div>
    <div class="relative mx-auto w-full max-w-3xl px-5 sm:px-8">
      <p class="label-tech">Error 404</p>
      <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">Esta página no existe.</h1>
      <p class="mt-4 max-w-xl text-ink-muted">
        Puede que el enlace haya cambiado o que la dirección esté mal escrita. Las opciones y precios siguen en la página
        principal.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-none bg-crimson px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-crimson-deep"
        >
          Volver al inicio
        </a>
        <a
          href="/#precios"
          class="inline-flex items-center gap-2 rounded-none border border-line px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-ink/40 hover:bg-surface"
        >
          Ver opciones y precios
        </a>
        <a
          href="/soporte"
          class="inline-flex items-center gap-2 rounded-none border border-line px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-ink/40 hover:bg-surface"
        >
          Soporte técnico
        </a>
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
