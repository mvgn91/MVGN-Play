---
// Navegación — cápsula mínima: logo + tema + botón de menú. Los enlaces viven
// en un panel a pantalla completa (en todos los tamaños). Sin JS hay un
// respaldo visible en <noscript>.
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import { whatsappLink } from '@/config/commerce';

const primary = [
  { href: '/#servicio', label: 'Servicio' },
  { href: '/#como-funciona', label: 'Cómo funciona' },
  { href: '/#precios', label: 'Precios' },
  { href: '/#soporte', label: 'Soporte' },
];

const secondary = [
  { href: '/#equipo', label: 'El equipo' },
  { href: '/#faq', label: 'Preguntas' },
  { href: '/condiciones', label: 'Condiciones' },
  { href: '/privacidad', label: 'Privacidad' },
];

const contact = whatsappLink();
---

<header class="fixed inset-x-0 top-0 z-50 flex justify-center px-4 pt-4">
  <nav
    aria-label="Principal"
    data-nav
    data-scrolled="false"
    class="flex items-center gap-1 rounded-none border border-line px-1.5 py-1.5 backdrop-blur-xl transition-shadow duration-300 data-[scrolled=true]:shadow-[0_16px_36px_-24px_var(--shadow-color)]"
    style="background-color: var(--nav-bg)"
  >
    <a
      href="/"
      class="flex items-baseline gap-1 rounded-none px-2.5 py-1 font-display text-base font-semibold tracking-tight"
    >
      <span>MVGN</span><span class="text-crimson">Play</span>
    </a>

    <ThemeToggle />

    <button
      type="button"
      data-menu-open
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Abrir menú"
      class="inline-flex h-9 w-9 items-center justify-center rounded-none border border-line text-ink transition-colors hover:border-line-strong"
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M4 8h16M4 16h16" stroke-linecap="round"></path>
      </svg>
    </button>
  </nav>
</header>

<!-- Respaldo sin JavaScript: los enlaces siguen disponibles -->
<noscript>
  <div class="fixed inset-x-0 top-0 z-50 border-b border-line bg-bg/95 backdrop-blur">
    <nav aria-label="Principal" class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-4 px-5 py-3 text-sm">
      <a href="/" class="font-display font-semibold">MVGN <span class="text-crimson">Play</span></a>
      {primary.map((link) => <a class="text-ink-muted hover:text-ink" href={link.href}>{link.label}</a>)}
      <a class="text-cool" href={contact ?? '/#consulta'}>WhatsApp</a>
    </nav>
  </div>
</noscript>

<!-- Panel de menú a pantalla completa -->
<div
  id="site-menu"
  data-menu-panel
  data-open="false"
  aria-hidden="true"
  inert
  class="fixed inset-0 z-60 invisible opacity-0 transition-[opacity,visibility] duration-300 data-[open=true]:visible data-[open=true]:opacity-100"
>
  <div
    role="dialog"
    aria-modal="true"
    aria-label="Menú principal"
    class="h-full overflow-y-auto bg-bg/96 px-5 py-4 backdrop-blur-xl transition-transform duration-300 ease-out data-[open=false]:translate-y-3 sm:px-8 sm:py-6"
    data-menu-surface
  >
    <div class="mx-auto flex w-full max-w-3xl items-center justify-between">
      <a href="/" class="flex items-baseline gap-1 font-display text-base font-semibold">
        <span>MVGN</span><span class="text-crimson">Play</span>
      </a>
      <button
        type="button"
        data-menu-close
        aria-label="Cerrar menú"
        class="inline-flex h-9 w-9 items-center justify-center rounded-none border border-line text-ink"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Menú principal" class="mx-auto mt-10 w-full max-w-3xl flex-1">
      <ul class="border-t border-line">
        {
          primary.map((link, index) => (
            <li class="border-b border-line">
              <a
                href={link.href}
                data-menu-link
                class="flex items-baseline justify-between py-5 font-display text-2xl font-medium text-ink transition-colors hover:text-crimson sm:py-6 sm:text-3xl"
              >
                <span>{link.label}</span>
                <span aria-hidden="true" class="font-mono text-[0.625rem] text-ink-muted">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {
          secondary.map((link) => (
            <li>
              <a
                href={link.href}
                data-menu-link
                class="text-ink-muted underline-offset-4 hover:text-ink hover:underline"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mx-auto mt-10 w-full max-w-3xl border-t border-line pt-5">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        {
          contact ? (
            <a
              href={contact}
              target="_blank"
              rel="noopener noreferrer"
              data-menu-link
              class="inline-flex items-center justify-center gap-2 rounded-none bg-crimson px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-crimson-deep sm:w-auto"
            >
              Consultar por WhatsApp
              <span aria-hidden="true">↗</span>
            </a>
          ) : null
        }
        <div class="flex items-center gap-3">
          <span class="text-sm text-ink-muted">Tema</span>
          <ThemeToggle />
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const sync = () => {
      nav.dataset.scrolled = window.scrollY > 8 ? 'true' : 'false';
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }

  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const surface = panel?.querySelector<HTMLElement>('[data-menu-surface]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeButton = panel?.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (panel && surface && openButton) {
    const setOpen = (open: boolean) => {
      panel.dataset.open = String(open);
      surface.dataset.open = String(open);
      panel.setAttribute('aria-hidden', String(!open));
      panel.inert = !open;
      openButton.setAttribute('aria-expanded', String(open));
      openButton.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      document.body.style.overflow = open ? 'hidden' : '';

      if (open) {
        (panel.querySelector<HTMLElement>('[data-menu-link]') ?? closeButton)?.focus();
      } else {
        openButton.focus();
      }
    };

    openButton.addEventListener('click', () => setOpen(panel.dataset.open !== 'true'));
    closeButton?.addEventListener('click', () => setOpen(false));
    panel.querySelectorAll('[data-menu-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    // Al cambiar de móvil a escritorio con el menú abierto, se cierra.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches && panel.dataset.open === 'true') setOpen(false);
    });

    const focusables = () => Array.from(panel.querySelectorAll<HTMLElement>('a[href], button'));

    panel.addEventListener('keydown', (event) => {
      if (panel.dataset.open !== 'true') return;

      if (event.key === 'Escape') {
        event.preventDefault();
        setOpen(false);
        return;
      }

      if (event.key !== 'Tab') return;

      const items = focusables();
      if (items.length === 0) return;

      const first = items[0];
      const last = items[items.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
