---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteNav from '@/layouts/SiteNav.astro';
import SiteFooter from '@/layouts/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lede?: string;
}

const { title, description, eyebrow, heading, lede } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <SiteNav />

  <main id="contenido" class="pt-32 pb-20 sm:pt-36">
    <div class="mx-auto w-full max-w-3xl px-5 sm:px-8" data-reveal>
      <a class="text-sm text-ink-muted underline-offset-4 hover:text-ink hover:underline" href="/">
        ← Volver al inicio
      </a>

      <p class="label-tech mt-8">{eyebrow}</p>
      <h1 class="mt-3 text-3xl font-semibold sm:text-4xl">{heading}</h1>
      {lede && <p class="mt-4 text-ink-muted">{lede}</p>}

      <div class="doc mt-10">
        <slot />
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
